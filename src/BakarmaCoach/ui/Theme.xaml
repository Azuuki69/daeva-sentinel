<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Gold" Color="#D7B77D"/>
  <SolidColorBrush x:Key="Muted" Color="#7F94B0"/>
  <DrawingImage x:Key="SentinelCrest">
    <DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#101E30" Geometry="M 48,4 L 78,22 L 74,68 L 48,94 L 22,68 L 18,22 Z"><GeometryDrawing.Pen><Pen Brush="#BFA574" Thickness="1.5"/></GeometryDrawing.Pen></GeometryDrawing>
      <GeometryDrawing Geometry="M 20,30 L 2,19 L 16,49 L 28,62 M 76,30 L 94,19 L 80,49 L 68,62 M 18,38 L 7,34 L 21,60 M 78,38 L 89,34 L 75,60"><GeometryDrawing.Pen><Pen Brush="#827150" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing>
      <GeometryDrawing Brush="#D6BD89" Geometry="M 48,19 L 63,45 L 48,74 L 33,45 Z"/>
      <GeometryDrawing Brush="#172C3D" Geometry="M 48,27 L 56,45 L 48,62 L 40,45 Z"/>
      <GeometryDrawing Brush="#95E0D6" Geometry="M 48,35 L 53,45 L 48,55 L 43,45 Z"/>
    </DrawingGroup></DrawingImage.Drawing>
  </DrawingImage>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE5F0"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="#8196B1"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#CCDAE9"/><Setter Property="Background" Value="#162439"/><Setter Property="BorderBrush" Value="#2C3C53"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8E7D5D"/><Setter TargetName="Surface" Property="Background" Value="#22364B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter><Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#D3FAEE"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#346F69"/><GradientStop Color="#204B51" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderBrush" Value="#5B9D91"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#95ABC5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="13,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C7D6E8"/><Setter Property="Margin" Value="0,9,0,9"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1828"/><Setter Property="Foreground" Value="#E0EAF6"/><Setter Property="BorderBrush" Value="#2D415C"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#DDE8F4"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="#0F1B2D" BorderBrush="#2C405B" BorderThickness="1" CornerRadius="5"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#C8B381" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#897654"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,7,28,7" IsHitTestVisible="False" VerticalAlignment="Center"/>
    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#111F32" BorderBrush="#665B46" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DAE6F4"/><Setter Property="Background" Value="#111F32"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#8FA5C0"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Padding" Value="17,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#E1C995"/><Setter TargetName="Surface" Property="BorderBrush" Value="#CCAF78"/><Setter TargetName="Surface" Property="Background" Value="#152337"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D7E6F4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><Border Grid.Row="1" Background="#A8111D2E" BorderBrush="#263A52" BorderThickness="1" CornerRadius="0,8,8,8" Padding="20,17"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
