<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Grid.Resources>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#080F1A"/><GradientStop Color="#14283B" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border BorderBrush="#303C48" BorderThickness="0,0,1,0"><Grid Margin="32,27,32,27"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="AION 2 COMPANION" Style="{StaticResource Eyebrow}" Foreground="#B9A478"/>
    <StackPanel Grid.Row="1" VerticalAlignment="Center"><Image Source="{StaticResource SentinelCrest}" Width="110" Height="120" HorizontalAlignment="Left" Margin="0,0,0,27"/><TextBlock Text="DAEVA" FontFamily="Georgia" FontSize="40" Foreground="#E2CC9F"/><TextBlock Text="SENTINEL" FontFamily="Georgia" FontSize="27" Foreground="#B8C8DB" Margin="0,2,0,0"/><Border Background="#82704E" Height="1" Width="45" HorizontalAlignment="Left" Margin="0,23,0,17"/><TextBlock Text="Your companion in Atreia." Foreground="#8EA5BF" FontSize="13"/></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="ENGLISH VOICE" FontSize="9" Foreground="#7CBEB5"/><TextBlock Text="Signed updates · English voice · No subscription" FontSize="10" Foreground="#58728E" Margin="0,8,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="32,27,32,27"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><ComboBox x:Name="Language" DockPanel.Dock="Right" Width="105"/><TextBlock Text="Launcher" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></DockPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock Text="Ready for the next encounter." FontFamily="Georgia" Foreground="#E1CDA8" FontSize="24" Margin="0,0,0,22"/>
      <Border BorderBrush="#34485B" BorderThickness="1" CornerRadius="8" Background="#9E0E1A2B" Padding="18"><StackPanel>
        <TextBlock x:Name="State" Text="Ready to play" Foreground="#8BD8CB" FontSize="14"/>
        <DockPanel Margin="0,14,0,0"><TextBlock Text="Installed version" Foreground="#758EAA" FontSize="11"/><TextBlock x:Name="Version" Foreground="#D5DFEA" HorizontalAlignment="Right" FontSize="11"/></DockPanel>
        <TextBlock x:Name="Latest" FontSize="11" Foreground="#7F9BB6" Margin="0,5,0,0"/>
        <ProgressBar x:Name="Progress" Height="2" Margin="0,14,0,0" Maximum="100" Background="#21354B" Foreground="#86D3C5"/>
        <TextBlock x:Name="Details" Text="Settings are preserved across updates." Foreground="#6E88A5" FontSize="10" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Button x:Name="Play" Content="Launch companion" Style="{StaticResource PrimaryButton}" Margin="0,16,0,10" FontSize="14" Padding="16,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Check" Content="Check for updates" Margin="0,0,5,0" Padding="8,9"/><Button x:Name="Rollback" Content="Rollback" Grid.Column="1" Margin="5,0,0,0" Padding="8,9" Background="Transparent"/></Grid>
    </StackPanel>
    <DockPanel Grid.Row="2"><Button x:Name="Github" Content="Open GitHub" Background="Transparent" BorderThickness="0" Foreground="#7993AD" Padding="0,6"/><TextBlock Text="DAEVA SENTINEL" FontSize="9" Foreground="#4C6680" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
</Grid>
