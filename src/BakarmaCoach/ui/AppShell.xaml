<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Grid.Resources>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#080E18"/><GradientStop Color="#111E30" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#D909111D" BorderBrush="#2D3540" BorderThickness="0,0,1,0"><DockPanel Margin="18,27,18,22">
    <StackPanel DockPanel.Dock="Top">
      <Image Source="{StaticResource SentinelCrest}" Width="60" Height="66" HorizontalAlignment="Center"/>
      <TextBlock Text="DAEVA" FontFamily="Georgia" FontSize="25" Foreground="#E2C58E" HorizontalAlignment="Center" Margin="0,13,0,0"/>
      <TextBlock Text="SENTINEL" FontSize="10" Foreground="#8CA4C0" HorizontalAlignment="Center" Margin="0,3,0,31"/>
      <TextBlock Text="OVERLAY VIEWS" Style="{StaticResource Eyebrow}" Margin="12,0,0,14"/>
      <Button x:Name="BossNav" Content="◈  Encounter" Style="{StaticResource NavButton}"/>
      <Button x:Name="DpsNav" Content="▥  DPS meter" Style="{StaticResource NavButton}"/>
      <Button x:Name="ThreatNav" Content="◇  Threat estimate" Style="{StaticResource NavButton}"/>
      <Border Height="1" Background="#243044" Margin="12,10,12,16"/>
      <Button x:Name="ScreenNav" Content="⌁  Screen reading" Style="{StaticResource NavButton}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="LANGUAGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ComboBox x:Name="UiLocale"/><TextBlock Text="ENGLISH VOICE" FontSize="9" Foreground="#79BAB6" Margin="0,18,0,6"/><TextBlock Text="AION 2 COMPANION" FontSize="9" Foreground="#4F6785"/></StackPanel><Border/>
  </DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="29,25,29,24">
    <DockPanel><Border DockPanel.Dock="Right" BorderBrush="#3F4350" BorderThickness="1" CornerRadius="11" Padding="10,4" VerticalAlignment="Top"><TextBlock x:Name="VersionBadge" Text="EU / GLOBAL" Foreground="#A8B6C8" FontSize="9"/></Border><StackPanel><TextBlock Text="Battle companion" FontFamily="Georgia" FontSize="28" Foreground="#E6D3AD"/><TextBlock Text="Test module: Transcendent Bakarma · Draupnir" Foreground="#7E96B3" FontSize="11" Margin="0,7,0,0"/></StackPanel></DockPanel>
    <Border Margin="0,22,0,16" CornerRadius="9" BorderBrush="#5C513D" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182B3D"/><GradientStop Color="#101C2D" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid Margin="20,17"><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#86D9C9" CornerRadius="1"/><StackPanel Grid.Column="1" Margin="15,0,0,0"><TextBlock x:Name="State" Text="READY TO TEST" Foreground="#7BCBBD" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="Alert" Text="Your next warning appears here." FontSize="21" FontWeight="SemiBold" Margin="0,8,0,8"/><DockPanel><TextBlock x:Name="Cast" Text="No live fight connected" FontSize="11" Foreground="#91A9C4"/></DockPanel><ProgressBar x:Name="CastBar" Height="2" Margin="0,12,0,0" Maximum="100" Foreground="#8DDED0" Background="#273B50"/></StackPanel></Grid>
    </Border>
    <WrapPanel Margin="0,0,0,12"><Button x:Name="Start" Content="Start live alerts" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="Overlay" Content="Show overlay" Margin="0,0,8,0"/><Button x:Name="Demo" Content="Play voice demo" Margin="0,0,8,0"/><Button x:Name="Stop" Content="Stop / reset" Background="Transparent"/></WrapPanel>
    <TextBlock x:Name="Status" Text="Live capture requires Npcap. The demo works without the game." FontSize="11" Foreground="#859BB5"/>
    <TextBlock x:Name="VoiceStatus" Text="Preparing local voice clips…" FontSize="10" Foreground="#69AFA9" Margin="0,5,0,19"/>
    <TabControl x:Name="SettingsTabs" Height="270">
      <TabItem Header="Encounter"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="DIFFICULTY" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/><ComboBox x:Name="Mode"/><TextBlock Text="Encounter profiles" FontSize="14" Foreground="#D3DFEC" Margin="0,19,0,6"/><TextBlock Text="Shared experimental rules for all three modes." Foreground="#829BB8" FontSize="11"/><TextBlock Text="Game names stay in their original language." Foreground="#829BB8" FontSize="11" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="OPTIONAL HP PREPARATION" Style="{StaticResource Eyebrow}"/><CheckBox x:Name="HpOn" Content="Enable unverified HP reminders"/><TextBox x:Name="HpValues" ToolTip="Comma-separated wave HP thresholds. Leave blank until confirmed."/><TextBlock Text="Optional and unverified. Disabled by default." Foreground="#8F9CAE" FontSize="11" Margin="0,10,0,0"/><TextBlock Text="Countdown means cast end, not wave arrival. Individual jump timing is not predicted." Foreground="#738AA6" FontSize="11" Margin="0,10,0,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Screen reading"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="INPUT SOURCES" Style="{StaticResource Eyebrow}"/><CheckBox x:Name="NetworkOn" Content="Network events"/><CheckBox x:Name="ScreenOn" Content="Screen capture + English OCR"/><WrapPanel Margin="0,7,0,0"><Button x:Name="Calibrate" Content="Calibrate screen" Margin="0,0,7,7"/><Button x:Name="Preview" Content="Preview screen reading" Margin="0,0,0,7"/></WrapPanel><TextBlock x:Name="ScreenStatus" Text="Screen input needs calibration: boss name + ability name." Foreground="#7D9AB9" FontSize="11"/></StackPanel>
        <Border Grid.Column="2" Background="#0D192A" CornerRadius="7" Padding="15"><StackPanel><TextBlock Text="Two sources. One warning." Foreground="#D8C59F" FontFamily="Georgia" FontSize="16"/><TextBlock Text="Network events supply timing. Screen OCR confirms visible skill names. Duplicate callouts are suppressed." Foreground="#8098B4" FontSize="11" Margin="0,11,0,0"/><TextBlock Text="Local recognition · screenshots stay in memory" Foreground="#649994" FontSize="10" Margin="0,16,0,0"/></StackPanel></Border>
      </Grid></TabItem>
      <TabItem Header="VOICE"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="VOICE" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/><ComboBox x:Name="Voices"/><DockPanel Margin="0,17,0,10"><TextBlock Text="Volume" Margin="0,0,14,0"/><Slider x:Name="Volume" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"/></DockPanel><CheckBox x:Name="VoiceOn" Content="Speak mechanic warnings"/><CheckBox x:Name="Countdown" Content="Speak cast-end countdown: 3, 2, 1"/></StackPanel>
        <Border Grid.Column="2" Background="#0D192A" CornerRadius="7" Padding="15"><StackPanel><TextBlock Text="English voice, always." Foreground="#D8C59F" FontFamily="Georgia" FontSize="16"/><TextBlock Text="Interface language changes the controls, not the spoken callouts or game names." Foreground="#8098B4" FontSize="11" Margin="0,11,0,14"/><Button x:Name="Test" Content="Test voice" HorizontalAlignment="Left"/></StackPanel></Border>
      </Grid></TabItem>
    </TabControl>
    <DockPanel Margin="0,17,0,0"><Button x:Name="ResetMeters" Content="Reset meters" DockPanel.Dock="Right" Padding="11,7" Margin="12,0,0,0"/><TextBlock Text="OVERLAY VIEW" Style="{StaticResource Eyebrow}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="OverlayTab"/></DockPanel>
    <TextBlock Text="DPS = recorded party damage / elapsed time. Threat bars are a damage-only proxy, not server enmity; taunts, tank bonuses and healing threat are not modeled." Foreground="#617C9B" FontSize="10" Margin="0,9,0,14"/>
    <DockPanel Margin="0,0,0,8"><TextBlock Text="RECENT CALLOUTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Ctrl+Alt+B · Ctrl+Alt+1/2/3" FontSize="9" Foreground="#58728F" HorizontalAlignment="Right"/></DockPanel>
    <ListBox x:Name="History" Height="64" Background="#0B1523" Foreground="#B5C8DF" BorderThickness="0" Padding="7" FontSize="11"/>
  </StackPanel></ScrollViewer>
</Grid>
